{
  "schemaVersion": 1,
  "id": "rustmi",
  "version": "${version}",
  "name": "Rustmi",
  "description": "Implementing Minecraft In Rust",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/rustmi/icon.png",
  "environment": "*",
  "entrypoints": {
    "mixinsquared": [
      "com.github.tatercertified.rustmi.compat.DebugifyMixinCanceller"
    ]
  },
  "mixins": [
    "rustmi.mixins.json"
  ],
  "accessWidener": "rustmi.accesswidener",
  "depends": {
    "fabricloader": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "breaks": {
    "rustmi_nalim": "*",
    "rustmi_panama": "*",
    "rustmi_membrane": "*"
  },
  "custom": {
    "lithium:options": {
      "math.sine_lut": false,
      "chunk.serialization": false
    }
  }
}
